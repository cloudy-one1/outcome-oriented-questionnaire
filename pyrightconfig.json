{
  // V2.6 引入：类型门禁。
  //
  // 为什么现在能开：src/ 在 basic 模式下是 **0 error**（本轮把暴露出来的 10 条
  // 全部当真问题修掉了：sqlite3.Cursor.lastrowid 可能为 None 却直接 int()、
  // random 模块被当 random.Random 实例传递、可选 numpy 绑定的联合类型等）。
  // 一条都不用豁免的门禁才有意义 —— 需要 baseline 的检查只会退化成装饰。
  //
  // gui/（Tkinter 宿主）曾于 v2.8 纳进来、45 条诊断全部清零 —— 那条判据留在这儿：
  // 需要豁免的门禁只会退化成装饰。宿主本体已在 v4.0 退役（设计稿 §10 第 7 步）。
  //
  // webui/ 与 run_web.py 于 v3.3.1 步骤 3 一并纳入：进来之前先量过，1214 句
  // 0 error，只有 8 条"随环境变成冗余"的 ignore 注释 —— 正是上面那条陷阱的翻版，
  // 全部删掉而不是留着豁免（导出/另存默认那两处改成 `_save_ready` 返回函数本身，
  // 检查与调用从此是同一个对象）。
  // v4.2：scripts/ 纳入 —— 三个门禁脚本（coverage_doc / e2e_gate / ci_annotate）
  // 自己写坏了类型只有跑起来才炸，行为测试兜不住类型面。tests/ 仍留门外：
  // 1.2 万行测试的类型收益低、改动成本高，是记录在案的决策（见 test_ci_guards）。
  "include": ["src", "webui", "scripts", "run_cli.py", "run_web.py", "conftest.py"],
  "exclude": ["**/__pycache__", ".pytest_cache", ".ruff_cache"],
  "typeCheckingMode": "basic",
  "pythonVersion": "3.10",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none",
  // 无用的 type: ignore 会随时间积累并掩盖真问题，直接判错
  "reportUnnecessaryTypeIgnoreComment": "warning"
}
